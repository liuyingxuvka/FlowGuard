{
  "schema_version": "flowguard.prompt_bundle_manifest.v2",
  "source_size_proxy_formula": "ceil(utf8_bytes/3)",
  "default_min_headroom_ratio": 0.10,
  "public_boundary": "one skill with on-demand domain references",
  "bundles": [
    {
      "route_id": "flowguard",
      "paths": [".agents/skills/flowguard/SKILL.md"],
      "max_utf8_bytes": 10000,
      "persistent_context_max_utf8_bytes": 10000,
      "min_headroom_ratio": 0.10,
      "stage_budgets": {
        "catalog": 4000,
        "preselection": 4000,
        "admitted_core": 4000,
        "triggered_expansion": 6000
      },
      "material": [
        {
          "path": ".agents/skills/flowguard/references/route_index.md",
          "stage": "preselection",
          "mandatory": true,
          "trigger": "public lifecycle selection",
          "owner": "flowguard",
          "claim": "compact route and subject index"
        },
        {
          "path": ".agents/skills/flowguard/references/route_execution_common.md",
          "stage": "admitted_core",
          "mandatory": true,
          "trigger": "route admitted",
          "owner": "flowguard",
          "claim": "shared route execution contract"
        },
        {
          "path": ".agents/skills/flowguard/references/routes/model_first_function_flow.md",
          "stage": "triggered_expansion",
          "mandatory": false,
          "trigger": "model-first subject selected",
          "owner": "model_first_function_flow",
          "claim": "kernel route fragment"
        },
        {
          "path": ".agents/skills/flowguard/references/domains/<subject>/protocol.md",
          "stage": "triggered_expansion",
          "mandatory": false,
          "trigger": "one explicit domain subject selected",
          "owner": "flowguard",
          "claim": "selected domain guidance only"
        }
      ]
    }
  ]
}
